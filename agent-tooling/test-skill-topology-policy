#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${1:-$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)}"
MANIFEST="$REPO_ROOT/agent-tooling/skill-topology.json"
REGISTRY="$REPO_ROOT/agent-tooling/distribution-topology/registry.json"
failed=0

fail() {
  printf 'skill topology policy: %s\n' "$1" >&2
  failed=1
}

for required in update-agents.sh update-all.sh update-skill-topology.sh sync-skill-surfaces.sh; do
  [ -f "$REPO_ROOT/agent-tooling/$required" ] || fail "missing public command: $required"
done

for candidate in "$REPO_ROOT"/agent-tooling/update-*.sh; do
  [ -e "$candidate" ] || continue
  name="${candidate##*/}"
  case "$name" in
    update-agents.sh|update-all.sh|update-skill-topology.sh) ;;
    *) fail "unexpected public updater: $name" ;;
  esac
done

while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  name="${candidate##*/}"
  case "$name" in
    update-skill-topology.sh|sync-skill-surfaces.sh) ;;
    *) fail "unexpected public topology command: $name" ;;
  esac
done < <(
  rg -l 'distribution-topology/topology\.sh|TOPOLOGY_PHASE=' \
    "$REPO_ROOT"/agent-tooling/*.sh || true
)

[ ! -e "$REPO_ROOT/agent-tooling/lib-plugins.sh" ] \
  || fail "generic plugin policy owner remains: lib-plugins.sh"

TOPOLOGY_DIR="$REPO_ROOT/agent-tooling/distribution-topology"
[ -x "$TOPOLOGY_DIR/topology.sh" ] \
  || fail "private Bash topology core missing or not executable"
if rg -q 'exec node|topology\.mjs' "$REPO_ROOT/agent-tooling/update-skill-topology.sh"; then
  fail "public topology command still invokes the retired Node core"
fi
if ! rg -q 'TOPOLOGY_PHASE=distribute' "$REPO_ROOT/agent-tooling/sync-skill-surfaces.sh"; then
  fail "sync-skill-surfaces.sh must run the distribute phase"
fi
if ! rg -q 'TOPOLOGY_PHASE=acquire' "$REPO_ROOT/agent-tooling/update-skill-topology.sh"; then
  fail "update-skill-topology.sh must run the acquire phase"
fi
if rg -q 'TOPOLOGY_PHASE=.*full' \
  "$REPO_ROOT/agent-tooling/update-skill-topology.sh" \
  "$REPO_ROOT/agent-tooling/sync-skill-surfaces.sh" \
  "$REPO_ROOT/agent-tooling/distribution-topology/topology.sh"; then
  fail "single-pass topology phase must stay deleted"
fi
if compgen -G "$TOPOLOGY_DIR/*.mjs" >/dev/null; then
  fail "retired Node topology implementation remains"
fi

invocations="$(
  # shellcheck disable=SC2016
  rg -N -o '\$SCRIPT_DIR/(update-[a-z-]+\.sh|sync-skill-surfaces\.sh)' \
    "$REPO_ROOT/agent-tooling/update-all.sh" \
    | sed 's#\$SCRIPT_DIR/##'
)"
expected_invocations='update-agents.sh
update-skill-topology.sh
sync-skill-surfaces.sh'
[ "$invocations" = "$expected_invocations" ] \
  || fail "update-all.sh must invoke agent updates, acquire, then distribute"

if ! jq -e --slurpfile registry "$REGISTRY" '
    ([.sources[].id] | length) == ([.sources[].id] | unique | length) and
    ([$registry[0][].sourceId] | length) == ([$registry[0][].sourceId] | unique | length) and
    ([.sources[].id] | sort) == ([$registry[0][].sourceId] | sort) and
    (all($registry[0][];
      (.command | startswith("adapters/")) and
      (.command | contains("..") | not)))
  ' "$MANIFEST" >/dev/null; then
  fail "manifest/adapter handshake or private adapter policy failed"
fi

if ! jq -e '
    .sources[] | select(.id == "repo-claude") |
    .defaultDestinations == ["claude"]
  ' "$MANIFEST" >/dev/null; then
  fail "repo-claude must default only to Claude"
fi

while IFS= read -r command; do
  [ -f "$REPO_ROOT/agent-tooling/distribution-topology/$command" ] \
    || fail "registered adapter missing: $command"
done < <(jq -r '.[].command' "$REGISTRY")

[ "$failed" -eq 0 ] || exit 1
printf 'skill topology policy passed\n'
