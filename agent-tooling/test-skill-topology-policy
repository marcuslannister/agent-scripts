#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${1:-$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)}"
MANIFEST="$REPO_ROOT/agent-tooling/skill-topology.json"
REGISTRY="$REPO_ROOT/agent-tooling/distribution-topology/registry.json"
TOPOLOGY_DIR="$REPO_ROOT/agent-tooling/distribution-topology"
failed=0

fail() {
  printf 'skill topology policy: %s\n' "$1" >&2
  failed=1
}

for required in update-agents.sh update-all.sh update-skill-topology.sh \
  generate-skills-matrix.py sync-skill-surfaces.sh; do
  [ -f "$REPO_ROOT/agent-tooling/$required" ] || fail "missing public command: $required"
done

for candidate in "$REPO_ROOT"/agent-tooling/update-*.sh; do
  [ -e "$candidate" ] || continue
  name="${candidate##*/}"
  case "$name" in
    update-agents.sh|update-all.sh|update-skill-topology.sh) ;;
    *) fail "unexpected public updater: $name" ;;
  esac
done

while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  [ "${candidate##*/}" = update-skill-topology.sh ] \
    || fail "unexpected public acquire command: ${candidate##*/}"
done < <(rg -l 'distribution-topology/topology\.sh|TOPOLOGY_PHASE=' \
  "$REPO_ROOT"/agent-tooling/*.sh || true)

[ -x "$TOPOLOGY_DIR/topology.sh" ] \
  || fail "private Bash acquire core missing or not executable"
[ -x "$TOPOLOGY_DIR/distribute.sh" ] \
  || fail "private Bash distribute core missing or not executable"
if ! rg -q 'TOPOLOGY_PHASE=acquire' "$REPO_ROOT/agent-tooling/update-skill-topology.sh"; then
  fail "update-skill-topology.sh must retain the acquire phase entry point"
fi
if rg -q 'TOPOLOGY_PHASE=' "$TOPOLOGY_DIR/topology.sh"; then
  fail "acquire topology core must not contain phase gating"
fi
if rg -q 'skill-topology\.json|registry\.json|distribution-topology/topology\.sh|TOPOLOGY_PHASE=' \
  "$REPO_ROOT/agent-tooling/sync-skill-surfaces.sh" "$TOPOLOGY_DIR/distribute.sh"; then
  fail "distribute must read neither the topology manifest nor adapter registry"
fi
for retired in matrix.sh claude-root.sh adapters/repo-owned.sh; do
  [ ! -e "$TOPOLOGY_DIR/$retired" ] || fail "retired topology module remains: $retired"
done
if compgen -G "$TOPOLOGY_DIR/*.mjs" >/dev/null; then
  fail "retired Node topology implementation remains"
fi

invocations="$(
  rg -N -o '\$SCRIPT_DIR/(update-[a-z-]+\.sh|generate-skills-matrix\.py|sync-skill-surfaces\.sh)' \
    "$REPO_ROOT/agent-tooling/update-all.sh" | sed 's#\$SCRIPT_DIR/##'
)"
expected_invocations='update-agents.sh
update-skill-topology.sh
generate-skills-matrix.py
sync-skill-surfaces.sh'
[ "$invocations" = "$expected_invocations" ] \
  || fail "update-all.sh must invoke agent updates, acquire, matrix refresh, then distribute"

if ! jq -e '
    .version == 1 and
    (.sources | type == "array" and length > 0) and
    ([.sources[].id] | length) == ([.sources[].id] | unique | length) and
    all(.sources[];
      (keys | sort) == ["classification","defaultDestinations","id"])
  ' "$MANIFEST" >/dev/null; then
  fail "topology manifest must contain acquire source policy only"
fi

if ! jq -e --slurpfile manifest "$MANIFEST" '
    ([.[].sourceId] | length) == ([.[].sourceId] | unique | length) and
    all(.[];
      (.command | startswith("adapters/")) and
      (.command | contains("..") | not) and
      (.sourceId as $id | any($manifest[0].sources[];
        .id == $id and .classification != "repo-owned")))
  ' "$REGISTRY" >/dev/null; then
  fail "acquire adapter registry policy failed"
fi

while IFS= read -r command; do
  [ -f "$TOPOLOGY_DIR/$command" ] || fail "registered adapter missing: $command"
done < <(jq -r '.[].command' "$REGISTRY")

[ "$failed" -eq 0 ] || exit 1
printf 'skill topology policy passed\n'
