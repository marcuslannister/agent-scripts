#!/usr/bin/env python3
"""Validate repo-owned SKILL.md front matter: valid YAML mapping with non-empty,
unique `name` and non-empty `description`. Used by hooks/pre-commit."""

import glob
import json
import os
import re
import subprocess
import sys

import yaml

# `\A---` ... `---` block on the first line, like the original Ruby gate.
FRONT_MATTER_RE = re.compile(r"\A---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|\Z)", re.DOTALL)
GH_SECRET_BODY_DASH_RE = re.compile(
    r"""
    \bgh[ \t]+secret[ \t]+set\b
    [^;\r\n|&]{0,500}?
    --body[ \t]+-
    (?=$|[\s`'";|&)\\])
    """,
    re.VERBOSE,
)


def repo_root():
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
        )
        return result.stdout.strip()
    except OSError:
        return ""


def load_front_matter(text):
    match = FRONT_MATTER_RE.match(text)
    if not match:
        return None, "front matter must start on the first line and close with ---"

    try:
        data = yaml.safe_load(match.group(1))
    except yaml.YAMLError as error:
        # problem_mark line/column are 0-based (unlike Ruby Psych); leave as-is.
        mark = getattr(error, "problem_mark", None)
        if mark is not None:
            problem = getattr(error, "problem", None) or str(error)
            return None, f"YAML: {problem} at line {mark.line} column {mark.column}"
        return None, f"YAML: {error}"
    except Exception as error:  # noqa: BLE001 - PyYAML constructors raise ValueError etc. on bad scalars (e.g. invalid dates); turn into a validation failure like Ruby's rescue StandardError, never a crash.
        return None, f"YAML: {error}"

    if not isinstance(data, dict):
        return None, "front matter must be a YAML mapping"

    return data, None


def gh_secret_body_dash_line(text):
    lines = text.splitlines()

    for index, line in enumerate(lines):
        if GH_SECRET_BODY_DASH_RE.search(line):
            return index + 1

    for index, (first, second) in enumerate(zip(lines, lines[1:])):
        boundary = len(first)
        match = GH_SECRET_BODY_DASH_RE.search(f"{first} {second}")
        if match and match.start() < boundary < match.end():
            return index + 1

    return None


def main():
    root = repo_root()
    os.chdir(root if root else os.getcwd())

    skill_files = sorted(glob.glob("skills/*/SKILL.md") + glob.glob("codex-skills/*/SKILL.md"))
    errors = []
    names = {}

    for path in skill_files:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()

        bad_secret_line = gh_secret_body_dash_line(text)
        if bad_secret_line:
            errors.append(
                (
                    path,
                    f"line {bad_secret_line}: `gh secret set` must read stdin by omitting "
                    "`--body`; never use `--body -`",
                )
            )

        data, error = load_front_matter(text)
        if error:
            errors.append((path, error))
            continue

        for field in ("name", "description"):
            value = data.get(field)
            if isinstance(value, str) and value.strip():
                continue
            errors.append((path, f"missing non-empty string field: {field}"))

        name = data.get("name")
        if not (isinstance(name, str) and name.strip()):
            continue

        normalized = name.strip()
        if normalized in names:
            # ensure_ascii=False so non-ASCII names quote like Ruby's .inspect.
            quoted = json.dumps(normalized, ensure_ascii=False)
            errors.append((path, f"duplicate skill name {quoted} also used by {names[normalized]}"))
        else:
            names[normalized] = path

    if not skill_files:
        print("No repo-owned SKILL.md files found.", file=sys.stderr)
        sys.exit(0)

    if errors:
        print("Skill validation failed:", file=sys.stderr)
        for path, error in errors:
            print(f"- {path}: {error}", file=sys.stderr)
        sys.exit(1)

    print(f"Validated {len(skill_files)} skill(s).")


if __name__ == "__main__":
    main()
