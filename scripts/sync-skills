#!/usr/bin/env bash
# Retired (ADR-0009). This upstream path is kept present for the upstream-complete
# root overlay (ADR-0008), but its symlink mirror is superseded and unsafe here:
# it linked whole roots into ~/.codex/skills (a root nothing reads since ADR-0001)
# and per-skill symlinks into ~/.claude/skills, which distribute now refuses.
#
# Use the reconciled per-skill copies instead:
#   agent-tooling/sync-skill-surfaces.sh   distribute tracked skills to both surfaces
#   agent-tooling/update-local.sh          full secondary-machine update
set -eo pipefail

printf '%s\n' \
  'sync-skills is retired (ADR-0009).' \
  'Skill surfaces are marker-owned per-skill copies selected by the skills matrix.' \
  'Run agent-tooling/sync-skill-surfaces.sh instead.' >&2
exit 2
